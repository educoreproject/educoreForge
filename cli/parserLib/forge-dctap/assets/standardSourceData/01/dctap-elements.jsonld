{
  "@context": {
    "dctap": "https://www.dublincore.org/specifications/dctap/",
    "dme": "https://educore.org/dme/vocab/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "@vocab": "https://educore.org/dme/vocab/",

    "Standard": "dme:Standard",
    "Component": "dme:Component",
    "Element": "dme:Element",
    "Concept": "dme:Concept",
    "AllowedValueSet": "dme:AllowedValueSet",
    "AllowedValue": "dme:AllowedValue",

    "name": "rdfs:label",
    "description": "dme:description",
    "definition": "skos:definition",
    "cardinality": "dme:cardinality",
    "version": "dme:version",
    "publishedDate": "dme:publishedDate",
    "editor": "dme:editor",
    "sourceURL": {"@id": "dme:sourceURL", "@type": "@id"},

    "hasComponent": {"@id": "dme:hasComponent", "@type": "@id", "@container": "@list"},
    "hasElement":   {"@id": "dme:hasElement",   "@type": "@id", "@container": "@list"},
    "definesConcept": {"@id": "dme:definesConcept", "@type": "@id", "@container": "@list"},
    "belongsToComponent": {"@id": "dme:belongsToComponent", "@type": "@id"},
    "constrainedBy": {"@id": "dme:constrainedBy", "@type": "@id"},
    "hasValue":      {"@id": "dme:hasValue",      "@type": "@id", "@container": "@list"},
    "broader":       {"@id": "skos:broader",      "@type": "@id"}
  },

  "@graph": [

    {
      "@id": "dctap:DCTAP",
      "@type": "Standard",
      "name": "DCTAP",
      "fullName": "Dublin Core Tabular Application Profile",
      "description": "DCTAP is a tabular format and an associated vocabulary of elements for specifying Dublin Core Application Profiles. A DCTAP defines metadata structures as shapes (groups of statement templates that share a subject) plus statement templates (a property and rules constraining its value, along with labels and notes).",
      "version": "Draft - Request for Comments",
      "publishedDate": "2022-12-16",
      "editor": "Karen Coyle",
      "sourceURL": "https://www.dublincore.org/specifications/dctap/elements/",
      "hasComponent": ["dctap:shape", "dctap:statementTemplate"],
      "definesConcept": [
        "dctap:concept_Profile",
        "dctap:concept_Shape",
        "dctap:concept_StatementTemplate"
      ]
    },

    {
      "@id": "dctap:shape",
      "@type": "Component",
      "name": "shape",
      "description": "A shape is a group of statement templates that share a subject and are identified with the same shapeID. A set of statement templates that applies to a single entity or concept defines a shape.",
      "definition": "A group of statement templates that share a subject and are identified with the same shapeID.",
      "hasElement": ["dctap:shapeID", "dctap:shapeLabel"]
    },
    {
      "@id": "dctap:statementTemplate",
      "@type": "Component",
      "name": "statement template",
      "description": "A statement template consists of a property, rules that constrain the property and its value, labels, and notes.",
      "definition": "A statement template consists of a property, rules that constrain the property and its value, labels, and notes.",
      "hasElement": [
        "dctap:propertyID",
        "dctap:propertyLabel",
        "dctap:mandatory",
        "dctap:repeatable",
        "dctap:valueNodeType",
        "dctap:valueDataType",
        "dctap:valueShape",
        "dctap:valueConstraint",
        "dctap:valueConstraintType",
        "dctap:note"
      ]
    },

    {
      "@id": "dctap:shapeID",
      "@type": "Element",
      "name": "shapeID",
      "cardinality": "0..1",
      "description": "A literal or IRI that uniquely identifies the shape within the context of the profile.",
      "belongsToComponent": "dctap:shape"
    },
    {
      "@id": "dctap:shapeLabel",
      "@type": "Element",
      "name": "shapeLabel",
      "cardinality": "0..1",
      "description": "A human-readable label for the shape.",
      "belongsToComponent": "dctap:shape"
    },
    {
      "@id": "dctap:propertyID",
      "@type": "Element",
      "name": "propertyID",
      "cardinality": "1",
      "description": "An IRI or literal that identifies the property. It is recommended to use an identifier of a vocabulary term defined in an existing vocabulary.",
      "belongsToComponent": "dctap:statementTemplate"
    },
    {
      "@id": "dctap:propertyLabel",
      "@type": "Element",
      "name": "propertyLabel",
      "cardinality": "0..1",
      "description": "A human-readable label for the property.",
      "belongsToComponent": "dctap:statementTemplate"
    },
    {
      "@id": "dctap:mandatory",
      "@type": "Element",
      "name": "mandatory",
      "cardinality": "0..1",
      "description": "Indicates whether or not the metadata must contain a statement that is consistent with this statement template. Boolean value: 'true'/'false' or '1'/'0'.",
      "belongsToComponent": "dctap:statementTemplate",
      "constrainedBy": "dctap:_booleanValueSet"
    },
    {
      "@id": "dctap:repeatable",
      "@type": "Element",
      "name": "repeatable",
      "cardinality": "0..1",
      "description": "Indicates whether or not the metadata may contain multiple instances of statements that are consistent with this statement template. Boolean value: 'true'/'false' or '1'/'0'.",
      "belongsToComponent": "dctap:statementTemplate",
      "constrainedBy": "dctap:_booleanValueSet"
    },
    {
      "@id": "dctap:valueNodeType",
      "@type": "Element",
      "name": "valueNodeType",
      "cardinality": "0..1",
      "description": "The node type of the value node. When using RDF properties, the minimum set of values is: 'IRI', 'literal', 'bnode'.",
      "belongsToComponent": "dctap:statementTemplate",
      "constrainedBy": "dctap:_valueNodeTypeSet"
    },
    {
      "@id": "dctap:valueDataType",
      "@type": "Element",
      "name": "valueDataType",
      "cardinality": "0..1",
      "description": "The data type of the value. Should be expressed with a standard identified type such as those defined in the XML Schema Datatypes specification (XSD 1.1 Part 2). For RDF literal values, use those defined in RDF Concepts - Datatypes.",
      "belongsToComponent": "dctap:statementTemplate"
    },
    {
      "@id": "dctap:valueShape",
      "@type": "Element",
      "name": "valueShape",
      "cardinality": "0..1",
      "description": "The valueShape of a property is a string matching a shapeID in the same profile. The string may be in the form of an IRI.",
      "belongsToComponent": "dctap:statementTemplate"
    },
    {
      "@id": "dctap:valueConstraint",
      "@type": "Element",
      "name": "valueConstraint",
      "cardinality": "0..1",
      "description": "Rules relating to the value beyond that which has been defined by the property, the valueNodeType and valueDataType.",
      "belongsToComponent": "dctap:statementTemplate"
    },
    {
      "@id": "dctap:valueConstraintType",
      "@type": "Element",
      "name": "valueConstraintType",
      "cardinality": "0..1",
      "description": "Names the type of constraint placed on the value. Without this, value constraints may not be actionable.",
      "belongsToComponent": "dctap:statementTemplate",
      "constrainedBy": "dctap:_valueConstraintTypeSet"
    },
    {
      "@id": "dctap:note",
      "@type": "Element",
      "name": "note",
      "cardinality": "0..1",
      "description": "Any explanatory information related to the statement template or any part of the statement template, generally in natural language.",
      "belongsToComponent": "dctap:statementTemplate"
    },

    {
      "@id": "dctap:_booleanValueSet",
      "@type": "AllowedValueSet",
      "name": "DCTAP boolean values",
      "description": "Accepted boolean values for mandatory and repeatable elements.",
      "hasValue": [
        "dctap:_v_true",
        "dctap:_v_false",
        "dctap:_v_1",
        "dctap:_v_0"
      ]
    },
    { "@id": "dctap:_v_true",  "@type": "AllowedValue", "name": "true",  "description": "Boolean true."  },
    { "@id": "dctap:_v_false", "@type": "AllowedValue", "name": "false", "description": "Boolean false." },
    { "@id": "dctap:_v_1",     "@type": "AllowedValue", "name": "1",     "description": "Boolean true (numeric)."  },
    { "@id": "dctap:_v_0",     "@type": "AllowedValue", "name": "0",     "description": "Boolean false (numeric)." },

    {
      "@id": "dctap:_valueNodeTypeSet",
      "@type": "AllowedValueSet",
      "name": "DCTAP valueNodeType values",
      "description": "Minimum set of valueNodeType values when using RDF properties.",
      "hasValue": [
        "dctap:_v_IRI",
        "dctap:_v_literal",
        "dctap:_v_bnode"
      ]
    },
    { "@id": "dctap:_v_IRI",     "@type": "AllowedValue", "name": "IRI",     "description": "An Internationalized Resource Identifier — a named resource node." },
    { "@id": "dctap:_v_literal", "@type": "AllowedValue", "name": "literal", "description": "A literal value (string, number, date, etc.)." },
    { "@id": "dctap:_v_bnode",   "@type": "AllowedValue", "name": "bnode",   "description": "A blank node — an anonymous resource." },

    {
      "@id": "dctap:_valueConstraintTypeSet",
      "@type": "AllowedValueSet",
      "name": "DCTAP valueConstraintType values",
      "description": "Minimum set of value constraint types defined in the DC TAP primer. Other types may be supplied in a TAP.",
      "hasValue": [
        "dctap:_v_picklist",
        "dctap:_v_IRIstem",
        "dctap:_v_pattern",
        "dctap:_v_languageTag",
        "dctap:_v_minLength",
        "dctap:_v_maxLength",
        "dctap:_v_minInclusive",
        "dctap:_v_maxInclusive"
      ]
    },
    { "@id": "dctap:_v_picklist",     "@type": "AllowedValue", "name": "picklist",     "description": "Value must be drawn from a defined list of allowed values." },
    { "@id": "dctap:_v_IRIstem",      "@type": "AllowedValue", "name": "IRIstem",      "description": "Value must be an IRI beginning with a specified stem." },
    { "@id": "dctap:_v_pattern",      "@type": "AllowedValue", "name": "pattern",      "description": "Value must match a regular-expression pattern." },
    { "@id": "dctap:_v_languageTag",  "@type": "AllowedValue", "name": "languageTag",  "description": "Value must carry a specified language tag." },
    { "@id": "dctap:_v_minLength",    "@type": "AllowedValue", "name": "minLength",    "description": "Value must have at least the specified number of characters." },
    { "@id": "dctap:_v_maxLength",    "@type": "AllowedValue", "name": "maxLength",    "description": "Value must have at most the specified number of characters." },
    { "@id": "dctap:_v_minInclusive", "@type": "AllowedValue", "name": "minInclusive", "description": "Value must be greater than or equal to the specified minimum." },
    { "@id": "dctap:_v_maxInclusive", "@type": "AllowedValue", "name": "maxInclusive", "description": "Value must be less than or equal to the specified maximum." },

    {
      "@id": "dctap:concept_Profile",
      "@type": "Concept",
      "name": "Profile",
      "description": "Using terms from existing vocabularies, an application profile specifies the structures and metadata terms used in a dataset. At a minimum the profile must provide the data elements, or properties, that are valid for use in the metadata. A profile may also further define metadata validity, such as value constraints and cardinality of elements.",
      "definition": "An application profile specifies the structures and metadata terms used in a dataset, drawing terms from existing vocabularies and adding constraints on validity, cardinality, and allowed values."
    },
    {
      "@id": "dctap:concept_Shape",
      "@type": "Concept",
      "name": "Shape",
      "description": "A shape is a group of statement templates that share a subject and are identified with the same shapeID. A set of statement templates that applies to a single entity or concept defines a shape.",
      "definition": "A group of statement templates that share a subject and are identified with the same shapeID.",
      "broader": "dctap:concept_Profile"
    },
    {
      "@id": "dctap:concept_StatementTemplate",
      "@type": "Concept",
      "name": "Statement template",
      "description": "A statement template consists of a property, rules that constrain the property and its value, labels, and notes.",
      "definition": "A property paired with rules that constrain the property and its value, plus labels and notes.",
      "broader": "dctap:concept_Shape"
    }

  ]
}
