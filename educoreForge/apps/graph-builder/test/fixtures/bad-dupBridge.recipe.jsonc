{
  // ISOLATED FAULT (referential): the SAME bridge named TWICE on the SAME (source, hub) pairing.
  // Two DIFFERENT bridges on one pair is now legal (design_bridgeResolution_072526 §3a) — the
  // referential key is source::hub::<bridgeName>, so only a repeated bridge NAME collides. This
  // fixture is the same-name collision; good-twoBridgesOnePair is its legal twin.
  "schemaVersion": "1.0.0",
  "recipeName": "badDupBridge",
  "kind": "dev",
  "description": "test fixture bad-dupBridge (single-cause: description present since campaign P2, W-C-10)",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "lif", "version": "current" }
  ],
  "hubs": [{ "standard": "ceds" }],
  "bridges": [
    { "source": "lif", "bridge": "semanticBridge", "hub": "ceds", "dependencies": ["lif", "ceds"] },
    { "source": "lif", "bridge": "semanticBridge", "hub": "ceds", "dependencies": ["lif", "ceds"] }
  ]
}
