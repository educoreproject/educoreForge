{
  // ISOLATED FAULT (referential): the same (source, hub) pairing declared twice.
  "schemaVersion": "1.0.0",
  "recipeName": "badDupPairing",
  "kind": "dev",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "lif", "version": "current" }
  ],
  "hubs": [{ "standard": "ceds", "candidateFinder": "semanticDefText" }],
  "bridges": [
    { "source": "lif", "hub": "ceds", "dependencies": ["lif", "ceds"], "cacheMode": "reuse" },
    { "source": "lif", "hub": "ceds", "dependencies": ["lif", "ceds"], "cacheMode": "fresh" }
  ]
}
