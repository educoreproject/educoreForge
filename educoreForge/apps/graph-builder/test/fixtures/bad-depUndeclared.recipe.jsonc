  "hubs": [{ "standard": "ceds", "candidateFinder": "semanticDefText" }],
  "bridges": [
    { "source": "lif", "mapper": "lifIntoCedsSemantic", "hub": "ceds", "dependencies": ["lif", "sif"], "cacheMode": "reuse" }
  ]
}
