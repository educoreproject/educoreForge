{
  // ISOLATED FAULT (referential): a dependency names a standard not in standards[].
  "schemaVersion": "1.0.0",
  "recipeName": "badDepUndeclared",
  "kind": "dev",
  "standards": [
    { "token": "ceds", "version": "current" },
