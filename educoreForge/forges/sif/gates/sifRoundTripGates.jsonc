{
	// sifRoundTripGates.jsonc — the SIF round-trip gate suite, DECLARED AS DATA (RT-10).
	//
	// Why data and not code (the CEDS lesson, twice learned): a gate written as
	// { measure, comparator, expected } cannot compute a signal and forget to assert it —
	// the gate does not contain the check, the harness does.
	//
	// EVERY gate names a twin — a fault injection in lib/roundTripGateTwins.js that must turn
	// it RED. A gate whose twin has not been observed failing is UNPROVEN, never PASS.
	// There are NO expectFail gates; a red suite during enrichment is correct and its redness
	// is the work order. UNMEASURED is a FAILURE, never a skip.
	//
	// SIF-specific gates: G-13 (the ORDER-SWAP probe, R-SF-1/R-SF-7 — the diff must go RED
	// naming the sequence change) and G-14 (the SCALE report, the phase's research finding,
	// including the largest group's member and pair counts per the supervisor's R-SF-7
	// addition).
	//
	// Measures are dotted paths into the measurement bundle the test assembles from the REAL
	// fixture verdict and the REAL probe runs. 'report.*' reads the diff report, 'verdict.*'
	// the RT-6 artifact, 'probe.*' facts established by executed probes, 'suite.*' facts about
	// this suite itself.
	"gates": [
		{
			"id": "G-1",
			"title": "INVENTED is zero — an invention is an assertion about SIF that SIF never made",
			"measure": "report.headline.invented",
			"comparator": "isZero",
			"twin": "injectOneInventedStatement"
		},
		{
			"id": "G-2",
			"title": "the hermetic fixture round-trips CLEAN (RT-7: the instrument can report success)",
			"measure": "verdict.roundTripClean",
			"comparator": "isTrue",
			"twin": "dropOneSourceStatement"
		},
		{
			"id": "G-3",
			"title": "every lost predicate row carries located samples — LOST is actionable, not a total",
			"measure": "probe.lostRowsWithoutSamples",
			"comparator": "isZero",
			"twin": "stripOneLostSampleList"
		},
		{
			"id": "G-4",
			"title": "declaredContext + contentGap sums exactly to LOST — no uncategorized loss",
			"measure": "probe.lostCategorySumMatches",
			"comparator": "isTrue",
			"twin": "misSumLostCategories"
		},
		{
			"id": "G-5",
			"title": "the verdict names its snapshot (per-file SHA256 + combined digest)",
			"measure": "probe.snapshotIdentityWellFormed",
			"comparator": "isTrue",
			"twin": "blankSnapshotDigest"
		},
		{
			"id": "G-6",
			"title": "the verdict names its graph (root provenance + node/edge counts)",
			"measure": "probe.graphIdentityPresent",
			"comparator": "isTrue",
			"twin": "dropGraphIdentity"
		},
		{
			"id": "G-7",
			"title": "size floor — two empty statement sets are identical, and identical is not success",
			"measure": "report.headline.sourceStatements",
			"comparator": "atLeast",
			"expected": 60,
			"twin": "emptyBothSides"
		},
		{
			"id": "G-8",
			"title": "no percentage participates in acceptance — counts only",
			"measure": "suite.gatesUsingPercentInAcceptance",
			"comparator": "isZero",
			"twin": "declarePercentGate"
		},
		{
			"id": "G-9",
			"title": "CHEATING DETECTOR — a deleted graph fact shows up LOST by name; if it does not, the validator knew data it should not (RT-5)",
			"measure": "probe.deletedFactShowsLost",
			"comparator": "isTrue",
			"twin": "falsifyCheatingDetectorProbe"
		},
		{
			"id": "G-10",
			"title": "an injected graph fact fires INVENTED by name",
			"measure": "probe.injectedFactShowsInvented",
			"comparator": "isTrue",
			"twin": "falsifyInventionProbe"
		},
		{
			"id": "G-11",
			"title": "refusals are BY NAME (missing container/snapshot/checksums/candidates each named; no over-refusal on intact input)",
			"measure": "probe.refusalsAllNamed",
			"comparator": "isTrue",
			"twin": "falsifyRefusalProbe"
		},
		{
			"id": "G-12",
			"title": "the fixture leaves no unmodeled source content — the instrument measured everything it was shown",
			"measure": "probe.unmodeledConstructTotal",
			"comparator": "isZero",
			"twin": "smuggleUnmodeledConstruct"
		},
		{
			"id": "G-13",
			"title": "ORDER-SWAP (R-SF-1/R-SF-7) — swapping two members' ordinals turns the diff RED with paired LOST/INVENTED precedence statements naming the group and both members",
			"measure": "probe.orderSwapShowsPairedRedNamingMembers",
			"comparator": "isTrue",
			"twin": "falsifyOrderSwapProbe"
		},
		{
			"id": "G-14",
			"title": "the SCALE report is present and well-formed (runtime, memory, statement censuses, largest group's member and pair counts)",
			"measure": "probe.scaleReportWellFormed",
			"comparator": "isTrue",
			"twin": "blankScaleReport"
		},
		// ---- PHASE 4 (the CHARACTERISTICS enrichment). G-15/16/17 guard the three distinct claims
		// the enrichment makes: that the closed vocabulary REFUSES rather than defaults, that the
		// derivation is exactly the ratified table and never touches an unstated cell, and that the
		// derived pair can never reach the round-trip statement domain. G-17 is the important one:
		// it is the structural guard against curing LOST by manufacturing INVENTED.
		{
			"id": "G-15",
			"title": "an unlisted Characteristics value is REFUSED BY NAME, never defaulted (the real forge observed throwing, message naming the bad value and the closed vocabulary)",
			"measure": "probe.characteristicsRefusalNamed",
			"comparator": "isTrue",
			"twin": "falsifyCharacteristicsRefusalProbe"
		},
		{
			"id": "G-16",
			"title": "every carried Characteristics value derives EXACTLY per the ratified table (checked against a table re-stated independently in the test), and a field whose cell is empty carries NONE of the three properties",
			"measure": "probe.characteristicsDerivationExact",
			"comparator": "isTrue",
			"twin": "falsifyCharacteristicsDerivationProbe"
		},
		{
			"id": "G-17",
			"title": "ANTI-INVENTION CONTRACT — neither derived property appears in the round-trip compiler's FIELD_PROPERTY_NAMES projection, so an interpretation can never be re-emitted as a source statement",
			"measure": "probe.derivedPropertiesOutsideStatementDomain",
			"comparator": "isTrue",
			"twin": "falsifyDerivedPropertyIsolationProbe"
		}
	]
}
