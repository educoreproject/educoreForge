<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="HighSchoolTranscript">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NoteMessage" type="core:NoteMessageType" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="Student" type="AcRec:K12StudentType" minOccurs="1" maxOccurs="1"/>
				<xs:element name="TransmissionData" type="AcRec:TransmissionDataType" minOccurs="1" maxOccurs="1"/>
				<xs:element name="UserDefinedExtensions" type="core:UserDefinedExtensionsType" minOccurs="0" maxOccurs="1"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
