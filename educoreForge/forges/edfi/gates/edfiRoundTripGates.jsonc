{
	// edfiRoundTripGates.jsonc — the forge-edfi round-trip gate suite, DECLARED AS DATA (RT-10).
	//
	// Why data and not code (the CEDS lesson, twice learned): a gate written as
	// { measure, comparator, expected } cannot compute a signal and forget to assert it —
	// the gate does not contain the check, the harness (lib/roundTripGates.js) does.
	//
	// EVERY gate names a twin in lib/roundTripGateTwins.js that must turn it RED. A gate whose
	// twin has not been observed failing is UNPROVEN, never PASS. No expectFail gates.
	// UNMEASURED is a FAILURE, never a skip.
	//
	// Measurement bundle (assembled by test/test-edfiRoundTrip.js):
	//   verdict.*  — the RT-6 artifact of the CARRIABLE-vocabulary hermetic fixture (the RT-7
	//                fixture that MUST round-trip clean)
	//   report.*   — that verdict's embedded diff report
	//   probe.*    — facts established by EXECUTED probes: the FULL-vocabulary fixture run
	//                (whose losses must be exactly the ruled backlog classes), the data-level
	//                cheating-detector/invention injections through the graph double, the
	//                refusal battery, the adversarial/cosmetic canonicalization pairs, and the
	//                two-independent-readers census cross-check
	//   suite.*    — facts about this suite itself
	"gates": [
		{
			"id": "G-1",
			"title": "INVENTED is zero — an invention is an assertion about Ed-Fi that Ed-Fi never made (doctrine 5.3, hard from the first run)",
			"measure": "report.headline.invented",
			"comparator": "isZero",
			"twin": "injectOneInventedStatement"
		},
		{
			"id": "G-2",
			"title": "inventedTotal (diff + crosswalk guard) is zero — the combined invention meter the verdict judges by",
			"measure": "verdict.inventedTotal",
			"comparator": "isZero",
			"twin": "bumpInventedTotal"
		},
		{
			"id": "G-3",
			"title": "crosswalk invention guard: every stashed CEDS raw value appears verbatim in the CSVs (R-WO-12 set membership; no row matching)",
			"measure": "verdict.crosswalkGuard.violationCount",
			"comparator": "isZero",
			"twin": "doctorOneStashRawValue"
		},
		{
			"id": "G-4",
			"title": "the carriable-vocabulary hermetic fixture round-trips CLEAN (RT-7: the instrument can report success)",
			"measure": "verdict.roundTripClean",
			"comparator": "isTrue",
			"twin": "dropOneSourceStatement"
		},
		// G-5 was REDEFINED by the 2026-08 R-WO-15(d)/(f) remediation. It used to assert that the
		// FULL-vocabulary fixture lost exactly the three ruled backlog classes. Its measure was
		// `0 === 0 && [].every(...)`, which is TRUE ON AN EMPTY LOSS SET — so the moment the classes
		// were actually carried, the gate would have gone VACUOUSLY GREEN, passing for a reason with
		// no relation to its claim. The replacement asserts CARRIAGE, over a measure with two
		// distinct guards, and it is worth being precise about WHICH ONE DOES WHICH JOB, because a
		// later reader who confuses them will delete the half that matters.
		//
		//   FIXTURE-SHAPE guard (domainSizedAsExpected): the ruled-carriage domain reduces to
		//   exactly 9 statements — 5 componentKind, 3 itemMetaEdId, 1 itemNamespace. This is a
		//   comparison of module-level fixture text against declared constants and is therefore
		//   TRUE OR FALSE REGARDLESS OF THE RUN. It catches a fixture edited out from under the
		//   gate. It does NOT establish that the vocabulary reached this run.
		//
		//   RUN-PRESENCE guard (source === expectedCount, inside measureRuledCarriage): every
		//   expected predicate must have a per-predicate ROW PRESENT in this run's report carrying
		//   its expected source count, with lost zero. THIS is the conjunct that makes the gate
		//   unfakeable, because a run that never contained the vocabulary has no such rows and is
		//   refused by name ("NO per-predicate row at all") rather than passing for having lost
		//   nothing.
		//
		// The distinction is load-bearing: "nothing was lost" is TRUE ON AN EMPTY DOMAIN, and
		// measuring absence-from-a-loss-list reproduces that same vacuity one level down, since a
		// loss list only ever contains statements that were IN the source. See
		// test-edfiRoundTrip.js, the FULL-vocabulary step, where the carriable run — clean,
		// lossless and vocabulary-free — is fed to this measure as a live anti-vacuity control.
		{
			"id": "G-5",
			"title": "the FULL-vocabulary fixture round-trips CLEAN — the formerly-ruled R-WO-15(d)/(f) classes (componentKind, itemMetaEdId, itemNamespaceQualifier) are CARRIED, over a non-empty domain of declared size",
			"measure": "probe.fullVocabularyClean",
			"comparator": "isTrue",
			"twin": "falsifyFullVocabularyCleanProbe"
		},
		// G-6 and G-7 are CONDITIONAL-UNIVERSAL guards: "IF a loss exists, it is located and it is
		// labelled." With carriage complete their domain is EXPECTED TO BE EMPTY, which makes both
		// vacuously satisfied. They are deliberately kept, as REGRESSION detectors — a future forge
		// change that drops one of the carried properties repopulates them under its ruled backlog
		// name (roundTripDiff.js LOST_BUCKET_PREFIX_REGISTRY). Their green must never be read as
		// coverage; the suite says so out loud with harness.note() on every run.
		{
			"id": "G-6",
			"title": "every LOST record is located (file:line) and bucketed — LOST is actionable, not a total (domain expected EMPTY after carriage; regression detector)",
			"measure": "probe.lostAllLocatedAndBucketed",
			"comparator": "isTrue",
			"twin": "stripOneLostLocation"
		},
		{
			"id": "G-7",
			"title": "no anonymous loss — every contentGap LOST record carries a named backlog label (domain expected EMPTY after carriage; regression detector)",
			"measure": "probe.fullVocabularyUnlabeledContentGapCount",
			"comparator": "isZero",
			"twin": "stripOneBacklogLabel"
		},
		{
			"id": "G-8",
			"title": "two independent readers agree — the reducer census equals the Phase 1 parser census over the same fixture (R-WO-14 bounding)",
			"measure": "probe.censusCrossCheckAgreed",
			"comparator": "isTrue",
			"twin": "falsifyCensusProbe"
		},
		{
			"id": "G-9",
			"title": "CHEATING DETECTOR — a deleted graph fact shows up LOST by name; if it does not, the validator knew data it should not (RT-5)",
			"measure": "probe.deletedFactShowsLost",
			"comparator": "isTrue",
			"twin": "falsifyCheatingDetectorProbe"
		},
		{
			"id": "G-10",
			"title": "an injected graph fact fires INVENTED by name",
			"measure": "probe.injectedFactShowsInvented",
			"comparator": "isTrue",
			"twin": "falsifyInventionProbe"
		},
		{
			"id": "G-11",
			"title": "refusals are BY NAME — missing input, corrupt bytes, manifest drift, absent bolt endpoint, namespace wrapper, unclassifiable text: each named, none skipped, and intact input is NOT over-refused",
			"measure": "probe.refusalsAllNamed",
			"comparator": "isTrue",
			"twin": "falsifyRefusalProbe"
		},
		{
			"id": "G-12",
			"title": "adversarial pairs stay DISTINCT — semantically different sources must not collapse (the over-forgiving instrument)",
			"measure": "probe.adversarialPairsAllDistinct",
			"comparator": "isTrue",
			"twin": "collapseAdversarialPair"
		},
		{
			"id": "G-13",
			"title": "cosmetic variants COLLAPSE — whitespace/order/comment differences must not read as loss (the over-strict instrument)",
			"measure": "probe.cosmeticVariantsCollapse",
			"comparator": "isTrue",
			"twin": "splitCosmeticPair"
		},
		{
			"id": "G-14",
			"title": "the verdict carries the complete RT-6 shape — counts, roundTripClean, snapshot identity (per-input digests + combined), graph identity",
			"measure": "probe.verdictShapeComplete",
			"comparator": "isTrue",
			"twin": "dropVerdictField"
		},
		{
			"id": "G-15",
			"title": "size floor — two empty statement sets are identical, and identical is not success",
			"measure": "report.headline.sourceStatements",
			"comparator": "atLeast",
			"expected": 120,
			"twin": "emptyBothSides"
		},
		{
			"id": "G-16",
			"title": "no percentage participates in acceptance — counts only (fidelityPercentDisplayOnly is display only)",
			"measure": "suite.gatesUsingPercentInAcceptance",
			"comparator": "isZero",
			"twin": "declarePercentGate"
		},
		// ---- added by the 2026-08 R-WO-15(d)/(f) remediation ----
		// Each of the three has a measure-boundary twin below AND a DATA-LEVEL red observation in
		// the suite, because a twin proves only that a comparison bites, never that the measure was
		// computed correctly (roundTripGateTwins.js:9-16).
		{
			"id": "G-17",
			"title": "BOTH componentKind values are carried — element AND identityTemplate reproduced, not merely the common one",
			"measure": "probe.componentKindBothKindsCarried",
			"comparator": "isTrue",
			"twin": "falsifyComponentKindCarriageProbe"
		},
		{
			"id": "G-18",
			"title": "NON-EMISSION: an item declared with no metaEdId emits no itemMetaEdId statement, and invented stays zero — carrying more content must not manufacture any",
			"measure": "probe.idlessItemsEmitNothing",
			"comparator": "isTrue",
			"twin": "falsifyNonEmissionProbe"
		},
		{
			"id": "G-19",
			"title": "forge edge triples are DISTINCT — the replay engine MERGEs on (from, type, to), so duplicates collapse silently and become last-write-wins data loss once edges carry properties",
			"measure": "probe.forgeEdgeTriplesDistinct",
			"comparator": "isTrue",
			"twin": "falsifyEdgeUniquenessProbe"
		},
		// ---- added by PHASE P5 of the forge embed-text revision (embedText-091426, R-ET-5 / R-ET-20) ----
		// Measured at the DATA level in test/test-edfiRoundTrip.js: the carriable fixture's real forge
		// result plus one DmeEmbedText node and one EMBEDS_TEXT_OF edge (test/fixtures/embedTextNode.json),
		// through the double. The same conjunct computed over a run whose CONSTRUCT_ROLES admits the text
		// role is observed going FALSE there: emission refuses the text row by name and issues no verdict
		// (R-ET-36), so on Ed-Fi a leak is a FAILED stage, not inventedTotal > 0. It proves THE DIFF, not the
		// production Cypher allowlist (roundTripEdfiCompiler.js:378-381) — that is P7's live run.
		{
			"id": "G-20",
			"title": "a TEXT NODE and its EMBEDS_TEXT_OF edge are excluded: with them present inventedTotal is 0, lostTotal EQUALS the run without them, and the emitted statement set is byte-identical",
			"measure": "probe.embedTextExcludedFromEmission",
			"comparator": "isTrue",
			"twin": "admitEmbedTextRole"
		}
	]
}
