		<rdf:type rdf:resource="https://w3id.org/CEDStandards/terms/C900003" />
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
		<rdfs:label>Active</rdfs:label>
		<skos:definition>The fixture learner is actively enrolled.</skos:definition>
		<skos:inScheme rdf:resource="https://w3id.org/CEDStandards/terms/C900003" />
		<skos:notation>01</skos:notation>
		<skos:prefLabel>Active</skos:prefLabel>
	</owl:NamedIndividual>
	<owl:NamedIndividual rdf:about="https://w3id.org/CEDStandards/terms/NI900003000002">
		<dc:creator>Common Education Data Standards</dc:creator>
		<dc:description>The fixture learner has withdrawn.</dc:description>
