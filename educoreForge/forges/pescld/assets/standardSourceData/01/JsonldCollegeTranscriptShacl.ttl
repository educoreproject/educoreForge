# Combined SHACL shapes for PESC College Transcript
# Merged from: shacl.ttl, person-shacl.ttl, organization-shacl.ttl, contact-shacl.ttl, course-related-shacl.ttl, achieve-related-shacl.ttl, summary-related-shacl.ttl
@base <http://example.org/> .
@prefix ceds: <https://w3id.org/CEDStandards/terms/> .
@prefix ceterms: <https://purl.org/ctdl/terms/> .
@prefix elm: <http://data.europa.eu/snb/model/elm/> .
@prefix ex: <http://example.org/> .
@prefix pesc: <https://pesc.org/terms/> .
@prefix pescAcademicProgramTypes: <https://pesc.org/vocabs/AcademicProgramTypes#> .
@prefix pescAcademicSummaryTypes: <https://pesc.org/vocabs/AcademicSummaryTypes#> .
@prefix pescAccreditationBodyCodes: <https://pesc.org/vocabs/AccreditationBodyCodes#> .
@prefix pescConditionsMetCodes: <https://pesc.org/vocabs/ConditionsMetCodes#> .
@prefix pescCreditBasis: <https://pesc.org/vocabs/CreditBasis#> .
@prefix pescCreditLevels: <https://pesc.org/vocabs/CreditLevels#> .
@prefix pescDelinquencyCodes: <https://pesc.org/vocabs/DelinquencyCodes#> .
@prefix pescDocumentCompleteCodes: <https://pesc.org/vocabs/DocumentCompleteCodes#> .
@prefix pescDocumentOfficialCodes: <https://pesc.org/vocabs/DocumentOfficialCodes#> .
@prefix pescDocumentProcessCodes: <https://pesc.org/vocabs/DocumentProcessCodes#> .
@prefix pescDocumentTypeCodes: <https://pesc.org/vocabs/DocumentTypeCodes#> .
@prefix pescGenderCodes: <https://pesc.org/vocabs/Gender#> .
@prefix pescGradeStatusCodes: <https://pesc.org/vocabs/GradeStatusCodes#> .
@prefix pescHonorsLevels: <https://pesc.org/vocabs/HonorsLevels#> .
@prefix pescIdentifierTypes: <https://pesc.org/vocabs/IdentifierTypes#> .
@prefix pescLanguageProficiencyCodes: <https://pesc.org/vocabs/LanguageProficiencyCodes#> .
@prefix pescLanguageUsageCodes: <https://pesc.org/vocabs/LanguageUsageCodes#> .
@prefix pescNameCodes: <https://pesc.org/vocabs/NameCodes#> .
@prefix pescResidencyStatusCodes: <https://pesc.org/vocabs/ResidencyStatusCodes#> .
@prefix pescSchoolLevels: <https://pesc.org/vocabs/SchoolLevels#> .
@prefix pescSessionTypes: <https://pesc.org/vocabs/SessionTypes#> .
@prefix pescStudentLevelCodes: <https://pesc.org/vocabs/StudentLevelCodes#> .
@prefix pescSupplementalGradeCodes: <https://pesc.org/vocabs/SupplementalGradeCodes#> .
@prefix pescTestScoreMethods: <https://pesc.org/vocabs/TestScoreMethods#> .
@prefix pescTransmissionTypes: <https://pesc.org/vocabs/TransmissionTypes#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<AcademicAwardShape> a sh:NodeShape ;
    rdfs:label "Postsecondary Student Academic Award"@en ;
    sh:closed false ;
    sh:property <academicawardshapeAcademicAwardDate>,
        <academicawardshapeAcademicAwardLevelType>,
        <academicawardshapeAcademicAwardProgram>,
        <academicawardshapeAcademicAwardTitle>,
        <academicawardshapeAcademicCompletionDate>,
        <academicawardshapeAcademicCompletionIndicator>,
        <academicawardshapeAcademicDegreeRequirement>,
        <academicawardshapeAcademicHonors>,
        <academicawardshapeType> ;
    sh:targetClass ceds:C200335 .

<AcademicDegreeRequirementShape> a sh:NodeShape ;
    rdfs:label "Academic Degree Requirement"@en ;
    sh:closed false ;
    sh:property <academicdegreerequirementshapeThesisDissertationAdvisor>,
        <academicdegreerequirementshapeThesisDissertationTitle>,
        <academicdegreerequirementshapeType>,
        <academicdegreerequirementshapeURLAddress> ;
    sh:targetClass pesc:AcademicDegreeRequirement .

<AcademicHonorsShape> a sh:NodeShape ;
    rdfs:label "Academic Honors"@en ;
    sh:closed false ;
    sh:property <academichonorsshapeHonorsLevel>,
        <academichonorsshapeHonorsTitle>,
        <academichonorsshapeType> ;
    sh:targetClass pesc:AcademicHonors .

<AcademicProgramShape> a sh:NodeShape ;
    rdfs:label "Academic Program"@en ;
    sh:closed false ;
    sh:property <academicprogramshapeAcademicProgramName>,
        <academicprogramshapeAcademicProgramType>,
        <academicprogramshapeHasClassificationofInstructionalProgramCode>,
        <academicprogramshapeHasPart>,
        <academicprogramshapeOfferedBy>,
        <academicprogramshapeProgramHEGISCode>,
        <academicprogramshapeType> ;
    sh:targetClass ceds:C200331 .

<AcademicSessionShape> a sh:NodeShape ;
    rdfs:label "Academic Session"@en ;
    sh:closed false ;
    sh:property <academicsessionshapeHasSessionType>,
        <academicsessionshapeSessionBeginDate>,
        <academicsessionshapeSessionDesignator>,
        <academicsessionshapeSessionDesignatorSuffix>,
        <academicsessionshapeSessionEndDate>,
        <academicsessionshapeSessionName>,
        <academicsessionshapeSessionSchoolYear>,
        <academicsessionshapeType> ;
    sh:targetClass ceds:C200245 .

<AcademicSummaryShape> a sh:NodeShape ;
    rdfs:label "Academic Summary"@en ;
    sh:closed false ;
    sh:property <academicsummaryshapeAcademicHonors>,
        <academicsummaryshapeAcademicSummaryLevel>,
        <academicsummaryshapeAcademicSummaryType>,
        <academicsummaryshapeAdditionalNote>,
        <academicsummaryshapeDelinquencies>,
        <academicsummaryshapeEntryDate>,
        <academicsummaryshapeExitDate>,
        <academicsummaryshapeGPASummary>,
        <academicsummaryshapeIsSummaryForProgram>,
        <academicsummaryshapeSource>,
        <academicsummaryshapeType> ;
    sh:targetClass pesc:AcademicSummary .

<AccreditationShape> a sh:NodeShape ;
    rdfs:label "Accreditation"@en ;
    sh:closed false ;
    sh:property <accreditationshapeAccrediationBodyCode>,
        <accreditationshapeAccreditationAgencyName>,
        <accreditationshapeAdditionalNote>,
        <accreditationshapeType> ;
    sh:targetClass ceds:C200240 .

<AdditionalStudentAchievementShape> a sh:NodeShape ;
    rdfs:label "Additional Student Achievement"@en ;
    sh:closed false ;
    sh:property <additionalstudentachievementshapeAttributeAchieved>,
        <additionalstudentachievementshapeConditionsMetCode>,
        <additionalstudentachievementshapeConditionsMetDate>,
        <additionalstudentachievementshapeInCourse>,
        <additionalstudentachievementshapeLanguageAchieved>,
        <additionalstudentachievementshapeProficiencyAchieved>,
        <additionalstudentachievementshapeRequirementAchieved>,
        <additionalstudentachievementshapeType> ;
    sh:targetClass pesc:AdditionalStudentAchievement .

<AgencyIdentifierShape> a sh:NodeShape ;
    rdfs:label "Agency Identifier"@en ;
    sh:closed false ;
    sh:targetClass pesc:AgencyIdentifier .

<AwardSummaryShape> a sh:NodeShape ;
    rdfs:label "Award Summary"@en ;
    sh:closed false ;
    sh:property <awardsummaryshapeAcademicHonors>,
        <awardsummaryshapeAcademicSummaryLevel>,
        <awardsummaryshapeAcademicSummaryType>,
        <awardsummaryshapeAdditionalNote>,
        <awardsummaryshapeGPASummary>,
        <awardsummaryshapeIsSummaryForAward>,
        <awardsummaryshapeIsSummaryForProgram>,
        <awardsummaryshapeSource>,
        <awardsummaryshapeType> ;
    sh:targetClass pesc:AwardSummary .

<CollegeTranscriptShape> a sh:NodeShape ;
    rdfs:label "College Transcript"@en ;
    sh:closed false ;
    sh:property <collegetranscriptshapeAdditionalNote>,
        <collegetranscriptshapeCreatedDateTime>,
        <collegetranscriptshapeDescribesAchievement>,
        <collegetranscriptshapeDestination>,
        <collegetranscriptshapeDocumentCompleteCode>,
        <collegetranscriptshapeDocumentID>,
        <collegetranscriptshapeDocumentOfficialCode>,
        <collegetranscriptshapeDocumentProcessCode>,
        <collegetranscriptshapeDocumenttypeCode>,
        <collegetranscriptshapeHaspart>,
        <collegetranscriptshapeRequestTrackingID>,
        <collegetranscriptshapeSource>,
        <collegetranscriptshapeStudent>,
        <collegetranscriptshapeTransmissionType>,
        <collegetranscriptshapeType> ;
    sh:targetClass pesc:CollegeTranscript .

<ConceptShape> a sh:NodeShape ;
    rdfs:label "SKOS Concept"@en ;
    sh:closed false ;
    sh:targetClass skos:Concept .

<ContactShape> a sh:NodeShape ;
    rdfs:label "Contact"@en ;
    sh:closed false ;
    sh:property <contactshapeAdditionalNote>,
        <contactshapeAddress>,
        <contactshapeAttentionLine>,
        <contactshapeContactType>,
        <contactshapeEmailAddress>,
        <contactshapeFAXPhone>,
        <contactshapePhone>,
        <contactshapeType>,
        <contactshapeURL> ;
    sh:targetClass ceterms:ContactPoint .

<CourseAchievementShape> a sh:NodeShape ;
    rdfs:label "Course Achievement"@en ;
    sh:closed false ;
    sh:property <courseachievementshapeCourseAddDate>,
        <courseachievementshapeCourseDropDate>,
        <courseachievementshapeCourseEquivalentGrade>,
        <courseachievementshapeCourseGrade>,
        <courseachievementshapeCourseQualityPointsEarned>,
        <courseachievementshapeCourseSupplementalGrade>,
        <courseachievementshapeHasCourseRepeatCode>,
        <courseachievementshapeInCourse>,
        <courseachievementshapeInSection>,
        <courseachievementshapeInSession>,
        <courseachievementshapeNumberofCreditsEarned>,
        <courseachievementshapeType> ;
    sh:targetClass ceds:C200346 .

<CourseShape> a sh:NodeShape ;
    rdfs:label "Post Secondary Course"@en ;
    sh:closed false ;
    sh:property <courseshapeAgencyCourseID>,
        <courseshapeAttribute>,
        <courseshapeCourseAcademicGradeScaleCode>,
        <courseshapeCourseCreditValue>,
        <courseshapeCourseFiveDigitSCEDCode>,
        <courseshapeCourseNumber>,
        <courseshapeCourseOverrideSchool>,
        <courseshapeCourseSubjectAbbreviation>,
        <courseshapeCourseTitle>,
        <courseshapeHasClassificationofInstructionalProgramCode>,
        <courseshapeHasCourseCreditBasisType>,
        <courseshapeHasCourseCreditLevelType>,
        <courseshapeHasCourseCreditUnits>,
        <courseshapeHasCourseGradePointAverageApplicability>,
        <courseshapeHasCourseLevelType>,
        <courseshapeHasInstructionLanguage>,
        <courseshapeHasPostsecondarySection>,
        <courseshapeLicensure>,
        <courseshapeOfferedBy>,
        <courseshapeOriginalCourseIdentifier>,
        <courseshapeOverrideSchoolCourseNumber>,
        <courseshapeProficiency>,
        <courseshapeRequirement>,
        <courseshapeType> ;
    sh:targetClass ceds:C200328 .

<CourseSupplementalGradeShape> a sh:NodeShape ;
    rdfs:label "Course Supplemental Grade"@en ;
    sh:closed false ;
    sh:property <coursesupplementalgradeshapeCourseAcademicSupplementalGradeStatusCode>,
        <coursesupplementalgradeshapeSupplementalGrade>,
        <coursesupplementalgradeshapeSupplementalGradeCode>,
        <coursesupplementalgradeshapeSupplementalGradeSubSession>,
        <coursesupplementalgradeshapeType> ;
    sh:targetClass pesc:CourseSupplementalGrade .

<GPAShape> a sh:NodeShape ;
    rdfs:label "GPA"@en ;
    sh:closed false ;
    sh:property <gpashapeCreditHoursAttempted>,
        <gpashapeCreditHoursEarned>,
        <gpashapeCreditHoursGPA>,
        <gpashapeGPARangeMaximum>,
        <gpashapeGPARangeMinimum>,
        <gpashapeGradePointAverage>,
        <gpashapeHasCourseCreditUnits>,
        <gpashapeTotalQualityPoints>,
        <gpashapeType> ;
    sh:targetClass pesc:GPA .

<GradeShape> a sh:NodeShape ;
    rdfs:label "Grade"@en ;
    sh:closed false ;
    sh:property <gradeshapeCourseAcademicGrade>,
        <gradeshapeCourseAcademicGradeScaleCode>,
        <gradeshapeHasCourseAcademicGradeStatusCode>,
        <gradeshapeType> ;
    sh:targetClass pesc:Grade .

<LanguageShape> a sh:NodeShape ;
    rdfs:label "Person Language"@en ;
    sh:closed false ;
    sh:property <languageshapeHasISO669-2LanguageCode>,
        <languageshapeLanguageProficiency>,
        <languageshapeLanguageUsage>,
        <languageshapeType> ;
    sh:targetClass ceds:C200293 .

<LicensureAchievementShape> a sh:NodeShape ;
    rdfs:label "Licensure Achievement"@en ;
    sh:closed false ;
    sh:property <licensureachievementshapeInCourse>,
        <licensureachievementshapeLicensureAchieved>,
        <licensureachievementshapeLicensurePassageDate>,
        <licensureachievementshapeType> ;
    sh:targetClass pesc:LicensureAchievement .

<LicensureShape> a sh:NodeShape ;
    rdfs:label "Licensure"@en ;
    sh:closed false ;
    sh:property <licensureshapeLicensureName>,
        <licensureshapeType> ;
    sh:targetClass pesc:Licensure .

<NoteShape> a sh:NodeShape ;
    rdfs:label "Note"@en ;
    sh:closed false ;
    sh:property <noteshapeNoteliteral>,
        <noteshapeType> ;
    sh:targetClass elm:Note .

<OrganizationIdentificationShape> a sh:NodeShape ;
    rdfs:label "Organization Identification"@en ;
    sh:closed false ;
    sh:property <organizationidentificationshapeHasOrganizationIdentificationSystem>,
        <organizationidentificationshapeOrganizationIdentifier>,
        <organizationidentificationshapeType> ;
    sh:severity sh:Info ;
    sh:targetClass ceds:C200252 .

<OrganizationShape> a sh:NodeShape ;
    rdfs:label "Organization"@en ;
    sh:closed false ;
    sh:property <organizationshapeAdditionalNote>,
        <organizationshapeContact>,
        <organizationshapeHasOrganizationAccreditation>,
        <organizationshapeHasOrganizationIdentification>,
        <organizationshapeOrganizationName>,
        <organizationshapeSchoolLevel>,
        <organizationshapeType> ;
    sh:targetClass ceds:C200239 .

<PersonIdentificationShape> a sh:NodeShape ;
    rdfs:label "Person Identification"@en ;
    sh:closed false ;
    sh:property <personidentificationshapeHasStudentIdentificationSystem>,
        <personidentificationshapePersonIdentifier>,
        <personidentificationshapeType> ;
    sh:targetClass ceds:C200291 .

<PersonNameShape> a sh:NodeShape ;
    rdfs:label "Name"@en ;
    sh:closed false ;
    sh:property <personnameshapeCompositeName>,
        <personnameshapeFirstName>,
        <personnameshapeLastName>,
        <personnameshapeMiddleName>,
        <personnameshapeNameCode>,
        <personnameshapeNamePrefix>,
        <personnameshapeNameSuffix>,
        <personnameshapeType> ;
    sh:targetClass ceds:C200377 .

<PersonShape> a sh:NodeShape ;
    rdfs:label "Person"@en ;
    sh:closed false ;
    sh:property <personshapeAdditionalNote>,
        <personshapeBirthCity>,
        <personshapeBirthCountry>,
        <personshapeBirthDate>,
        <personshapeBirthStateProvinceCode>,
        <personshapeBirthYear>,
        <personshapeBirthday>,
        <personshapeCohortGraduationYear>,
        <personshapeContact>,
        <personshapeDeceasedIndicator>,
        <personshapeGenderCode>,
        <personshapeHasAchievement>,
        <personshapeHasOtherPersonName>,
        <personshapeHasPersonIdentification>,
        <personshapeHasPersonLanguage>,
        <personshapeHasPersonName>,
        <personshapeHasSummary>,
        <personshapeHighSchoolAttended>,
        <personshapeResidency>,
        <personshapeStudentLevel>,
        <personshapeType> ;
    sh:targetClass ceds:C200275 .

<PhoneShape> a sh:NodeShape ;
    rdfs:label "Phone"@en ;
    sh:closed false ;
    sh:property <phoneshapeCountryPrefixCode>,
        <phoneshapePhoneNumber>,
        <phoneshapePhoneNumberExtension>,
        <phoneshapeType> ;
    sh:targetClass pesc:Phone .

<PostalAddressShape> a sh:NodeShape ;
    rdfs:label "Postal Address"@en ;
    sh:closed false ;
    sh:property <postaladdressshapeAddressLocality>,
        <postaladdressshapeAddressRegion>,
        <postaladdressshapeCountryCode>,
        <postaladdressshapePostalCode>,
        <postaladdressshapeStreetAddress>,
        <postaladdressshapeType> ;
    sh:targetClass ceterms:PostalAddress .

<PostsecondarySectionLocationShape> a sh:NodeShape ;
    rdfs:label "Postsecondary Section Location"@en ;
    sh:closed false ;
    sh:property <postsecondarysectionlocationshapeCourseInstructionSiteName>,
        <postsecondarysectionlocationshapeHasCourseInstructionSiteType>,
        <postsecondarysectionlocationshapeType> ;
    sh:targetClass ceds:C200333 .

<PostsecondarySectionShape> a sh:NodeShape ;
    rdfs:label "Postsecondary Location"@en ;
    sh:closed false ;
    sh:property <postsecondarysectionshapeCourseBeginDate>,
        <postsecondarysectionshapeCourseEndDate>,
        <postsecondarysectionshapeCourseSectionNumber>,
        <postsecondarysectionshapeHasPostsecondarySectionLocation>,
        <postsecondarysectionshapeType> ;
    sh:targetClass ceds:C200332 .

<ProgramSummaryShape> a sh:NodeShape ;
    rdfs:label "Program Summary"@en ;
    sh:closed false ;
    sh:property <programsummaryshapeAcademicHonors>,
        <programsummaryshapeAcademicSummaryLevel>,
        <programsummaryshapeAcademicSummaryType>,
        <programsummaryshapeAdditionalNote>,
        <programsummaryshapeDelinquencies>,
        <programsummaryshapeExitDate>,
        <programsummaryshapeGPASummary>,
        <programsummaryshapeIsSummaryForProgram>,
        <programsummaryshapeSource>,
        <programsummaryshapeType> ;
    sh:targetClass pesc:ProgramSummary .

<RAPShape> a sh:NodeShape ;
    rdfs:label "Requirement, Attribute or Proficiency"@en ;
    sh:closed false ;
    sh:property <rapshapeRAPCode>,
        <rapshapeRAPName>,
        <rapshapeRAPSubName>,
        <rapshapeType> ;
    sh:targetClass ceds:C200065 .

<ResidencyShape> a sh:NodeShape ;
    rdfs:label "Residency"@en ;
    sh:closed false ;
    sh:property <residencyshapeCountry>,
        <residencyshapeCountryCode>,
        <residencyshapeCounty>,
        <residencyshapeCountyCode>,
        <residencyshapeResidencyStatusCode>,
        <residencyshapeStateProvince>,
        <residencyshapeStateProvinceCode>,
        <residencyshapeType> ;
    sh:targetClass pesc:Residency .

<SessionSummaryShape> a sh:NodeShape ;
    rdfs:label "Session Summary"@en ;
    sh:closed false ;
    sh:property <sessionsummaryshapeAcademicHonors>,
        <sessionsummaryshapeAcademicSummaryLevel>,
        <sessionsummaryshapeAcademicSummaryType>,
        <sessionsummaryshapeAdditionalNote>,
        <sessionsummaryshapeDelinquencies>,
        <sessionsummaryshapeEntryDate>,
        <sessionsummaryshapeExitDate>,
        <sessionsummaryshapeGPASummary>,
        <sessionsummaryshapeIsSummaryForProgram>,
        <sessionsummaryshapeIsSummaryForSession>,
        <sessionsummaryshapeSource>,
        <sessionsummaryshapeType> ;
    sh:targetClass pesc:SessionSummary .

<SubtestShape> a sh:NodeShape ;
    rdfs:label "Subtest"@en ;
    sh:closed false ;
    sh:property <subtestshapeSubtestIdentifier>,
        <subtestshapeSubtestTitle>,
        <subtestshapeType> ;
    sh:targetClass ceds:C200051 .

<SummaryShape> a sh:NodeShape ;
    rdfs:label "Summary"@en ;
    sh:closed false ;
    sh:targetClass pesc:Summary .

<TestScoreShape> a sh:NodeShape ;
    rdfs:label "Test Scores"@en ;
    sh:closed false ;
    sh:property <testscoreshapeAssessmentScoreMetricType>,
        <testscoreshapeInSubtest>,
        <testscoreshapeInTest>,
        <testscoreshapeScoreInvalidatedIndicator>,
        <testscoreshapeScoreRevisedIndicator>,
        <testscoreshapeScoreSelfReportedIndicator>,
        <testscoreshapeScoreValue>,
        <testscoreshapeStudentLevel>,
        <testscoreshapeTestDate>,
        <testscoreshapeTestYear>,
        <testscoreshapeTestYearMonth>,
        <testscoreshapeType> ;
    sh:targetClass ceds:C200047 .

<TestShape> a sh:NodeShape ;
    rdfs:label "Test"@en ;
    sh:closed false ;
    sh:property <testshapeAssessmentIdentifier>,
        <testshapeAssessmentTitle>,
        <testshapeHasSubtest>,
        <testshapeType> ;
    sh:targetClass ceds:C200010 .

<academicawardshapeAcademicAwardDate> a sh:PropertyShape ;
    rdfs:comment "ccyy-mm-dd"@eng ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "Academic Award Date"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path ceds:P000001 .

<academicawardshapeAcademicAwardLevelType> a sh:PropertyShape ;
    sh:in ( ceds:NI001668151655 ceds:NI001668151657 ceds:NI001668151658 ceds:NI001668151659 ceds:NI001668151660 ceds:NI001668151661 ceds:NI001668151662 ceds:NI001668151663 ceds:NI001668151664 ceds:NI001668151665 ceds:NI001668151666 ceds:NI001668151667 ceds:NI001668151668 ceds:NI001668151669 ceds:NI001668151670 ceds:NI001668151671 ceds:NI001668151687 ceds:NI001668151686 ) ;
    sh:maxCount 1 ;
    sh:name "Academic Award Level Type"@en-US ;
    sh:nodeKind sh:IRI ;
    sh:path ceds:P001668 .

<academicawardshapeAcademicAwardProgram> a sh:PropertyShape ;
    sh:class ceds:C200331 ;
    sh:minCount 1 ;
    sh:name "Academic Award Program"@en-US ;
    sh:node <AcademicProgramShape> ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:path pesc:inProgram .

<academicawardshapeAcademicAwardTitle> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 400 ;
    sh:name "Academic Award Title"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path ceds:P000003 .

<academicawardshapeAcademicCompletionDate> a sh:PropertyShape ;
    rdfs:comment "ccyy-mm-dd"@eng ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:name "Academic Completion Date"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:academicCompletionDate .

<academicawardshapeAcademicCompletionIndicator> a sh:PropertyShape ;
    rdfs:comment "true/false"@eng ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:name "Academic Completion Indicator"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:academicCompletionIndicator .

<academicawardshapeAcademicDegreeRequirement> a sh:PropertyShape ;
    sh:class pesc:AcademicDegreeRequirement ;
    sh:name "Academic Degree Requirement"@en-US ;
    sh:node <AcademicDegreeRequirementShape> ;
    sh:nodeKind sh:BlankNode ;
    sh:path pesc:academicDegreeRequirement .

<academicawardshapeAcademicHonors> a sh:PropertyShape ;
    sh:class pesc:AcademicHonors ;
    sh:name "Academic Honors"@en-US ;
    sh:node <AcademicHonorsShape> ;
    sh:nodeKind sh:BlankNode ;
    sh:path pesc:academicHonors .

<academicawardshapeType> a sh:PropertyShape ;
    sh:hasValue ceds:C200335 ;
    sh:minCount 1 ;
    sh:name "Type"@en-US ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:type .

<academicdegreerequirementshapeThesisDissertationAdvisor> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 45 ;
    sh:name "Thesis Dissertation Advisor"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:thesisDissertationAdvisor .

<academicdegreerequirementshapeThesisDissertationTitle> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 400 ;
    sh:name "Thesis Dissertation Title"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:thesisDIssertationTitle .

<academicdegreerequirementshapeType> a sh:PropertyShape ;
    sh:hasValue pesc:AcademicDegreeRequirement ;
    sh:minCount 1 ;
    sh:name "Type"@en-US ;
    sh:nodeKind sh:IRI ;
    sh:path rdf:type .

<academicdegreerequirementshapeURLAddress> a sh:PropertyShape ;
    rdfs:comment "URL of thesis / dissertation. Consider renaming this class"@eng ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
    sh:maxLength 512 ;
    sh:name "URL Address"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:urlAddress .

<academichonorsshapeHonorsLevel> a sh:PropertyShape ;
    sh:in ( pescHonorsLevels:FirstHighest pescHonorsLevels:SecondHighest pescHonorsLevels:ThirdHighest ) ;
    sh:maxCount 1 ;
    sh:name "Honors Level"@en-US ;
    sh:nodeKind sh:IRI ;
    sh:path pesc:honorsLevel .

<academichonorsshapeHonorsTitle> a sh:PropertyShape ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:maxLength 30 ;
    sh:name "Honors Title"@en-US ;
    sh:nodeKind sh:Literal ;
    sh:path pesc:honorsTitle .

