{
  // pescldDeclared — zeroBacklog lane C (WORKORDER-C C2, C3): PESC_LD beside both hubs, and its DECLARED-IDENTITY bridges. A PESC_LD
  // shape, profile row or picklist value whose term IS a hub's term (the same IRI) meets that hub's TERM card by EXACT_MATCH, matchBasis
  // declaredIdentity; which terms are a hub's, and the card key they map to, is the hub's own declaredTargetRuleList. Nothing is judged.
  // C2 bridged PESC_LD to one hub; C3 (on P9's term tier) adds the second to the same entry, each taking the hub's rules as
  // forges/pescld/bridges/pescldHubPairing.json says. Built into a DEV_ graph
  // with --rebridge=pescld --judgeCacheOnly=true: a declared basis asks nothing, so the cache-only guard is a seal.
  "schemaVersion": "1.0.0",
  "recipeName": "pescldDeclared",
  "kind": "dev",
  "description": "PESC_LD beside both hubs and its declared-identity bridges to each (C2, C3).",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "ctdl", "version": "current" },
    { "token": "pescld", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" },
    { "standard": "ctdl" }
  ],
  "bridges": [
    { "source": "pescld", "hubs": ["ceds", "ctdl"], "dependencies": ["pescld", "ceds", "ctdl"] }
  ]
}
