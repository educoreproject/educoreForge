{
  // sifBridgeOnly — the FAST ITERATION LOOP for the SIF bridge plugin: SIF + the CEDS hub only, one bridge.
  // DEV_ builds only; NEVER an acceptance run — the acceptance census (SPEC §11) and the frozen decision block
  // are keyed to the four-forge assembly (fourWithHubSifBridge.recipe.jsonc, manifest 97c618c2…), and a
  // relationship block id here differs from the four-forge one by construction (the block is coupled to the
  // source standardBase). Same plugin, same hub, same forged SIF nodes: the DECISION block's census over
  // SIF × CEDS is the same either way, which is what makes this loop useful. Mirrors edfiBridgeOnly exactly.
  "schemaVersion": "1.0.0",
  "recipeName": "sifBridgeOnly",
  "kind": "dev",
  "description": "SIF + the CEDS hub + the SIF → CEDS standard-declared bridge plugin — the fast DEV_ iteration loop for the plugin; not an acceptance recipe.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "sif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    { "source": "sif", "hub": "ceds", "bridge": "sifCedsStandardPlugin", "dependencies": ["sif", "ceds"] }
  ]
}
