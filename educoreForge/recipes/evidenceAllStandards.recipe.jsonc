  "bridges": [
    // ---- evidence-judged (Opus via the full evidence path; judgment-cached; forensics-logged) ----
    { "source": "ctdl", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["ctdl", "ceds"], "cacheMode": "reuse" },
    { "source": "lif", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["lif", "ceds"], "cacheMode": "reuse" },
    { "source": "dctap", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["dctap", "ceds"], "cacheMode": "reuse" },
