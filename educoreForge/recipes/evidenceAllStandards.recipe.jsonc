    { "source": "case", "hub": "ceds", "bridge": "caseEvidenceBridge", "dependencies": ["case", "ceds"], "cacheMode": "reuse" },
    { "source": "eduapi", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["eduapi", "ceds"], "cacheMode": "reuse" },
    { "source": "jedx", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["jedx", "ceds"], "cacheMode": "reuse" },
