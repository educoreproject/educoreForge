{
  // fourWithHubDebugBridged — THE FOUR CERTIFIED STANDARDS, THE CEDS HUB, AND BRIDGES.
  //
  // Commissioned by tqii 2026-08-11: "Run it again with bridging this time. Obviously,
  // useDebugJudge." The successor to fourWithHub.recipe.jsonc, which is its parent and STAYS — that
  // recipe is the hub-bearing baseline with no bridges, and remains the way to look at these four
  // standards without any mapping content at all.
  //
  // ⚠⚠ RUN THIS WITH --useDebugJudge OR IT SPENDS REAL OPUS CREDIT. ⚠⚠
  // Three pairings judge ~48,000 source elements between them. With a debug judge that is free and
  // mechanical; without one it is a real inference run against claude-opus-4-8 and would be by far
  // the most expensive thing this project has ever done. The recipe cannot enforce this — spending
  // is an operator switch (--rebridge scope + the absence of --useDebugJudge) — so it is stated
  // here as loudly as a comment can state it.
  //
  // WHAT THE THREE PAIRINGS ARE, AND WHY THEY DIFFER:
  //
  //   edfi -> authoredAnchorBridge   DETERMINISTIC. Resolves the SPECIFIED cedsId anchors by exact
  //                                  identity join, with NO LLM at all. --useDebugJudge does not
  //                                  touch it, so ITS EDGES ARE REAL: EXACT_MATCH,
  //                                  provenanceTier spec-authoritative. This graph is therefore
  //                                  MIXED — genuine specified mappings alongside mechanical ones —
  //                                  and the flagging is what keeps them apart.
  //
  //   sif  -> sifEvidenceBridge      LLM-JUDGED, so under --useDebugJudge every edge is mechanical
  //                                  and flagged INVALID_DEBUG. SIF's bespoke bridge exists because
  //                                  its leaf names are ruthlessly reused (Code on 1,125 fields);
  //                                  ancestry and document position are its real identity.
  //
  //   pesc260805 -> genericBridge    LLM-JUDGED, likewise flagged. PESC260805 HAS NO BESPOKE BRIDGE
  //                                  — this is its first pairing of any kind, and the zero-code
  //                                  genericBridge is exactly what a standard with no special
  //                                  structural signal is meant to use.
  //
  // NOTE THE ASYMMETRY OF THE RESULT. The edfi edges say something true about the specification; the
  // sif and pesc260805 edges say nothing about anything. A reader must not average them.
  //
  // BUILT BY REUSE WHERE THE STORE ALLOWS IT. Run against
  // dataStores/graphBuilder/fourWithHub_081126.standardsDatabase.sqlite3, which now holds all four
  // bases including the hub-bearing CEDS. --reuseForgedBlocks retrieves a base only when its version
  // can be named WITHOUT forging (provenance-file versions); ceds and edfi qualify, sif
  // (unknown_01) and pesc260805 (aggregate-01) do not and will forge. That is the reuse design
  // refusing to guess rather than a defect.
  "schemaVersion": "1.0.0",
  "recipeName": "fourWithHubDebugBridged",
  "kind": "dev",
  "description": "The four certified standards with the CEDS hub AND three bridge pairings. Intended for --useDebugJudge: the sif and pesc260805 edges are mechanical placeholders; the edfi edges are real specified anchors.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "edfi", "version": "current" },
    { "token": "pesc260805", "version": "current" },
    { "token": "sif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "edfi", "hub": "ceds", "bridge": "authoredAnchorBridge",
      "dependencies": ["edfi", "ceds"], "cacheMode": "reuse"
    },
    {
      "source": "sif", "hub": "ceds", "bridge": "sifEvidenceBridge",
      "dependencies": ["sif", "ceds"], "cacheMode": "reuse"
    },
    {
      "source": "pesc260805", "hub": "ceds", "bridge": "genericBridge",
      "dependencies": ["pesc260805", "ceds"], "cacheMode": "reuse"
    }
  ]
}
