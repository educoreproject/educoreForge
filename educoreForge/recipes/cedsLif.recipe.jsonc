{
  // cedsLif — NEW-FORMAT recipe exercising hubs + bridges: CEDS as hub, LIF mapped into it.
  // Referentially coherent: hub.standard and bridge endpoints all resolve within standards[].
  "schemaVersion": "1.0.0",
  "recipeName": "cedsLif",
  "kind": "dev",
  "description": "CEDS + LIF with a LIF->CEDS mapping bridge.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "lif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "lif", "hub": "ceds", "bridge": "semanticBridge",
      "dependencies": ["lif", "ceds"], "cacheMode": "reuse"
    }
  ]
}
