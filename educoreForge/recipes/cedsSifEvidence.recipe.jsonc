{
  // cedsSifEvidence — Bridge Evidence-Package Refactor Phase 6 (bridgeEvidenceRefactor-spec.md §7 P6):
  // CEDS + SIF, mapped with sifEvidenceBridge (forges/sif/bridges/sifEvidenceBridge.js) — SIF's
  // structural signal (deep XML ancestry + document-order sibling position, forged additively by
  // Phase A's sequence-capture work) re-expressed as EVIDENCE, in the SAME shape
  // cedsCaseEvidence.recipe.jsonc uses for CASE: a nomination hook (⟪A1⟫) recovers both token-sharing
  // AND author-declared-crossref candidates into the union pool, per-candidate considerations state
  // the source's full ancestry + a three-slot comparison + its sequence position among true XML
  // siblings, and one deduped global segment (R6/⟪A2⟫) tells the judge how to read SIF's ruthlessly
  // reused leaf-name vocabulary. Model: recipes/cedsCaseEvidence.recipe.jsonc — only the bridge name
  // and standard tokens differ.
  "schemaVersion": "1.0.0",
  "recipeName": "cedsSifEvidence",
  "kind": "dev",
  "description": "CEDS + SIF with a SIF->CEDS mapping bridge, using sifEvidenceBridge (evidence-mode: cosine ∪ leaf/ancestor-token nominations ∪ authored-crossref nominations, per-candidate ancestry + three-slot + sequence-context considerations, one deduped SIF leaf-name/code-artifact guidance segment) — Phase 6's SIF evidence-path bridge, patterned on cedsCaseEvidence.recipe.jsonc.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "sif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "sif", "hub": "ceds", "bridge": "sifEvidenceBridge",
      "dependencies": ["sif", "ceds"], "cacheMode": "reuse"
    }
  ]
}
