{
  // versionSample - a tiny 3-standard build for eyeballing the NEW schema/data in the store:
  // explicit versions (no 'current'), populated blocks.version, slugged subjects, and the manifest's
  // recipeHash + recipeFileName. Deliberately mixes cases:
  //   ctdlasn - a KNOWN version (subject ctdlasn@20230929_base, version 20230929)
  //   clr     - a KNOWN DOTTED version (subject clr@2_0_base slugged, version 2.0 pretty)
  //   jedx    - an UNKNOWN version (subject jedx@unknown_01_base, version unknown_01)
  // No hubs, no bridges. Cache-served, so zero Voyage.
  "schemaVersion": "1.0.0",
  "recipeName": "versionSample",
  "kind": "dev",
  "description": "Three small standards (known, dotted-known, unknown) to view the explicit-version schema in the store.",
  "standards": [
    { "token": "ctdlasn", "version": "current" },
    { "token": "clr", "version": "current" },
    { "token": "jedx", "version": "current" }
  ],
  "hubs": [],
  "bridges": []
}
