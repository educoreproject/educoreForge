{
  // cedsEdfiBlind — THE BLIND EVALUATION. CEDS(base + FULL tuple hub) + a BLINDED, 98-row Ed-Fi,
  // plus genericBridge so the inference path actually runs and can be scored.
  //
  // ⟪TQ, 2026-08-02⟫ "run a couple of ed-fi elements manually according to the bridge code to verify
  // that it does what you think it does, and then run the bridge on 100 elements."
  //
  // WHY THIS EXISTS AND WHAT IT MEASURES
  // Ed-Fi ships ~1,666 HUMAN-AUTHORED property-tier CEDS mappings carrying the full tuple. That is an
  // answer key. This recipe forges Ed-Fi from snapshot 02, in which every CEDS* column is EMPTY, so
  // the bridge is judged on Ed-Fi's own prose alone and the withheld answers are the score sheet.
  //
  // THE BLIND IS AT THE SOURCE, AND THAT IS DELIBERATE.
  // Blinding the GRAPH was tried first and proved insufficient. Code fact, read 2026-08-02:
  // genericBridge walks sources with flattenFullRecord (every raw scalar), and evidenceRenderer's
  // source block prints EVERY key except vector/embedding/searchText/stableId/_id/embedText. The
  // answer therefore rides in cedsId AND in crossRefs AND in cedsOriginalAnchorPropertyName — and
  // would ride in any 'holdoutCedsId' added to stash it, which would have looked blind (anchorMatch
  // dead) while printing the answer three lines further down the prompt. A source-level blind cannot
  // fail that way: the answer never enters the parser.
  //
  // THE SAMPLE IS MECHANICAL, NOT CHOSEN. All 1,666 element rows sorted by (EdFiEntity,
  // EdFiElementName), every 17th taken -> 98 rows over 69 entities. No hand-picking, so the sample
  // carries no bias toward easy or hard matches. Descriptors are header-only: this scores the
  // PROPERTY tier. (There is no source-limit option anywhere in the bridge's config surface —
  // role, judgmentKey, evidenceJudgeConcurrency, sourceStandard, sourceVersion, hubVersion — so the
  // scoping had to live in the snapshot.)
  //
  // NOTE THE VERSION. Snapshot 02 stamps the forged version 'unknown_02', so a blinded Ed-Fi block is
  // a DIFFERENT artifact from the real 'unknown_01' one and the two can never be confused in the
  // standards database. Requires forges/edfi/parserDescriptor.ini pinned to defaultSnapshot=02 —
  // TEMPORARY, restore to 01 when the evaluation ends.
  //
  // DEV/TEMPORARY. ⟪TQ⟫ "it can't become permanent because we are working on a temporary graph."
  "schemaVersion": "1.0.0",
  "recipeName": "cedsEdfiBlind",
  "kind": "dev",
  "description": "CEDS base + full-tuple hub + a BLINDED 98-row EdFi + genericBridge — the scored blind evaluation of the inference bridge against Ed-Fi's authored crosswalk.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "edfi", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    { "source": "edfi", "hub": "ceds", "bridge": "genericBridge", "dependencies": ["edfi", "ceds"], "cacheMode": "reuse" }
  ]
}
