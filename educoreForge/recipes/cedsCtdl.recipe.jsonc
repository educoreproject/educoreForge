{
  // cedsCtdl — NEW-FORMAT recipe: CEDS as hub, CTDL bridged into it by the AUTHORED EXACT_MATCH
  // producer (P2, implementationPlan_bridge_072426 §7). Deterministic — no vectors, no LLM. The
  // 'ctdlIntoCedsAuthored' mapper resolves (bridgeMaker.BRIDGE_PLUGIN_BY_MAPPER) to the CTDL authored
  // bridge plugin, which reads each forged CTDL node's native CEDS anchor and writes an EXACT_MATCH
  // edge to the resolved CEDS HubReference. The relationship block is named ceds@<v>_rel_ctdl@<v>_exact
  // (pair-scoped, version-keyed on both endpoints with the REAL resolved versions). Referentially
  // coherent: hub.standard and bridge endpoints all resolve within standards[].
  "schemaVersion": "1.0.0",
  "recipeName": "cedsCtdl",
  "kind": "dev",
  "description": "CEDS + CTDL with the CTDL->CEDS authored EXACT_MATCH bridge.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "ctdl", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "ctdl", "hub": "ceds", "bridge": "ctdlAuthoredBridge",
      "dependencies": ["ctdl", "ceds"], "cacheMode": "reuse"
    }
  ]
}
