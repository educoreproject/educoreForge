{
  // cedsCaseStructural — Bridge Kit Refactor Phase 5 pilot: CEDS + CASE, mapped with
  // caseStructuralBridge (forges/case/bridges/caseStructuralBridge.js) — genericBridge's construction
  // call copied with ONE move overridden (`match`): base definition-cosine AUGMENTED with a
  // structural-affinity term derived from CASE's casePath (className+propertyName) vs each CEDS
  // candidate's name+description. Identical to cedsCaseGeneric.recipe.jsonc EXCEPT the bridge name —
  // a clean A/B pair proving whether the structural signal changes CASE's picks.
  "schemaVersion": "1.0.0",
  "recipeName": "cedsCaseStructural",
  "kind": "dev",
  "description": "CEDS + CASE with a CASE->CEDS mapping bridge, using caseStructuralBridge (def-cosine + structural-affinity blend) — the Phase 5 pilot, A/B'd against cedsCaseGeneric.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "case", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds", "candidateFinder": "semanticDefText", "params": { "topK": 15, "cosineFloor": 0 } }
  ],
  "bridges": [
    {
      "source": "case", "hub": "ceds", "bridge": "caseStructuralBridge",
      "extractor": "defaultSearchObject",
      "dependencies": ["case", "ceds"], "cacheMode": "reuse"
    }
  ]
}
