{
  // cedsCtdlLifDemo — the combined demo (design_bridgeResolution_072526.md §9 step 3): CEDS as the
  // hub, with CTDL and LIF both bridged into it. It is the recipe that PROVES the new model, because
  // the ctdl::ceds pairing now carries TWO bridges — the authored EXACT_MATCH producer AND the
  // inferred CLOSE_MATCH (semantic) producer — which the old source::hub uniqueness key wrongly
  // refused as a "duplicate bridge pairing". Under the source::hub::<bridgeName> key (§3a) the two
  // are distinct and legal; the lif::ceds pairing adds a third bridge on a different pair.
  //
  // The `bridge` values are RESOLVABLE bridge-file basenames (§4): ctdlAuthoredBridge lives in the
  // standard-local scope forges/ctdl/bridges/ (found via source 'ctdl'); semanticBridge lives in the
  // library scope apps/graph-builder/apps/bridge-maker/bridges/ and serves every semantic pair.
  //
  // ORDER IS MEANINGFUL (§2): authored EXACT first, then the inferred CLOSE pass over the same pair,
  // then LIF's semantic pass. Materialize-only — the CTDL and LIF decision blocks are already frozen,
  // so a plain build spends nothing; Milo (the parent) runs the reforge, not the test suite.
  "schemaVersion": "1.0.0",
  "recipeName": "cedsCtdlLifDemo",
  "kind": "dev",
  "description": "CEDS hub + CTDL (authored EXACT + inferred CLOSE) + LIF (inferred CLOSE) — the combined two-producers-per-pair demo.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "ctdl", "version": "current" },
    { "token": "lif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "ctdl", "hub": "ceds", "bridge": "ctdlAuthoredBridge",
      "dependencies": ["ctdl", "ceds"], "cacheMode": "reuse"
    },
    {
      "source": "ctdl", "hub": "ceds", "bridge": "semanticBridge",
      "dependencies": ["ctdl", "ceds"], "cacheMode": "reuse"
    },
    {
      "source": "lif", "hub": "ceds", "bridge": "semanticBridge",
      "dependencies": ["lif", "ceds"], "cacheMode": "reuse"
    }
  ]
}
