{
  // cedsSifStudentPersonal — THE SIF TRIAL (TQ ruling 2026-07-31: "figure out a way to only bridge
  // the SIF StudentPersonals object as a trial... so that we can build the rest without redoing
  // it"). CEDS + the FULL SIF base (every field forged, sequence-stamped, browsable), but the
  // evidence bridge judges ONLY fields owned by the StudentPersonal object (242 fields, 40 native
  // CEDS anchors) via bridges[].params.sifObjectScope — the trial-scope seam in
  // forges/sif/bridges/sifEvidenceBridge.js. WHY NOTHING IS REDONE LATER: every trial judgment
  // lands in the shared judgment cache under its promptHash; the full-SIF run
  // (recipes/cedsSifEvidence.recipe.jsonc, no scope) re-renders byte-identical prompts for these
  // 242 fields and replays them FREE — the scope changes which sources are judged now, never how
  // any source is judged.
  "schemaVersion": "1.0.0",
  "recipeName": "cedsSifStudentPersonal",
  "kind": "dev",
  "description": "SIF trial: full CEDS+SIF bases, evidence-judged mapping for ONLY the StudentPersonal object's 242 fields (sifObjectScope) — judgments bank in the shared cache so the eventual full SIF run replays them free.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "sif", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" }
  ],
  "bridges": [
    {
      "source": "sif", "hub": "ceds", "bridge": "sifEvidenceBridge",
      "dependencies": ["sif", "ceds"], "cacheMode": "reuse",
      "params": { "sifObjectScope": ["StudentPersonal"] }
    }
  ]
}
