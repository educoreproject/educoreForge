{
  // ctdlFamily — the CTDL family as ONE graph: the three sub-standards (CTDL, CTDL-ASN, CTDL-QData)
  // forged as base blocks, plus ONE coordinating intra-family STRUCTURAL bridge that reads the whole
  // family once and emits the THREE pairwise pair-scoped `_struct` blocks (HAS_PROPERTY / REFERENCES /
  // SUBCLASS_OF / HAS_OPTION_SET) by the ctdlFamilyStructure producer (LOCATOR_EDGE + same-URI identity
  // join). No CEDS hub — the siblings do not map to CEDS; their only cross-standard link is this family
  // structure.
  //
  // ONE PRODUCER, THREE BLOCKS (TQ 2026-07-26). This is a SINGLE bridge entry, sourced from the family
  // ROOT (ctdl), that internally covers all three pairings. The producer emits three pair-scoped,
  // version-keyed blocks in one pass (S11 order: family-root first then lexicographic —
  // ctdl::ctdlasn, ctdl::ctdlqdata, ctdlasn::ctdlqdata) and build.js Phase C harvests EACH into its own
  // `_struct` block. Because the one entry is sourced from ctdl, it resolves in forges/ctdl/bridges/
  // where ctdlFamilyStructure.js lives — the placement failure the three-invocation shape hit (a
  // ctdlasn::ctdlqdata entry sourced from ctdlasn searching forges/ctdlasn/bridges/) simply cannot arise.
  //
  // `familyStandards` is the whole family the producer coordinates over (the pairing universe AND the
  // read scope, read once). `dependencies` lists the same three so their base blocks are restored into
  // the dependency graph for the producer to walk.
  "schemaVersion": "1.0.0",
  "recipeName": "ctdlFamily",
  "kind": "dev",
  "description": "CTDL family (CTDL + CTDL-ASN + CTDL-QData) with one coordinating intra-family structural bridge emitting the three pairwise pair-scoped structural blocks.",
  "standards": [
    { "token": "ctdl", "version": "current" },
    { "token": "ctdlasn", "version": "current" },
    { "token": "ctdlqdata", "version": "current" }
  ],
  "hubs": [],
  "bridges": [
    { "source": "ctdl", "bridge": "ctdlFamilyStructure", "familyStandards": ["ctdl", "ctdlasn", "ctdlqdata"], "dependencies": ["ctdl", "ctdlasn", "ctdlqdata"], "cacheMode": "reuse" }
  ]
}
