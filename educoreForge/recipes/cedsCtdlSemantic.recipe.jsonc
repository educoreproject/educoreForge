{
  // cedsCtdlSemantic — CEDS(base+hub) + CTDL + the INFERRED CTDL->CEDS CLOSE_MATCH bridge (semantic).
  // P3b-run real-inference proof: --rebridge=ctdl runs the real Voyage embed + real Opus rerank, freezes
  // the decision block, materializes CLOSE_MATCH. Semantic-only (one ctdl->ceds pairing; authored is a
  // separate recipe — duplicate (source,hub) pairing is refused). Should reconcile ~146 CLOSE_MATCH vs golden.
  "schemaVersion": "1.0.0",
  "recipeName": "cedsCtdlSemantic",
  "kind": "dev",
  "description": "CEDS+hub + CTDL + inferred CTDL->CEDS CLOSE_MATCH bridge (semantic, --rebridge).",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "ctdl", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds", "candidateFinder": "semanticDefText", "params": { "topK": 15, "cosineFloor": 0 } }
  ],
  "bridges": [
    {
      "source": "ctdl", "hub": "ceds", "bridge": "semanticBridge",
      "extractor": "defaultSearchObject",
      "dependencies": ["ctdl", "ceds"], "cacheMode": "reuse"
    }
  ]
}
