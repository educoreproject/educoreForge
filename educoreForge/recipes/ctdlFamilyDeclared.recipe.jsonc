{
  // ctdlFamilyDeclared — ctdlHub-101926 P6 (WORKORDER-P6 step 6): the CTDL family's DECLARED bridges in one build. CEDS and the three
  // CTDL-family standards, both hubs, and every bridge P6 adds: CTDL's 53 declared ceds: correspondences (DECLARED_CORRESPONDENCE to
  // CEDS base nodes), CTDL-ASN's 4 owl:equivalentProperty to CTDL (DECLARED_CORRESPONDENCE to CTDL base nodes), and the family
  // structure (three pair-scoped _struct blocks, harvested by cross-source pair). No judge: every bridge here is declared.
  // CTDL-QData has NO correspondence bridge: P0 measured zero correspondences on its own terms (recorded in DEVLOG-P6, not built).
  // Built into DEV_p6CtdlFamily with --rebridge=all --judgeCacheOnly=true; the declared bases ask nothing, so the cache-only guard
  // is a seal, not a supply. Do NOT point a DME at this graph before P7.
  "schemaVersion": "1.0.0",
  "recipeName": "ctdlFamilyDeclared",
  "kind": "dev",
  "description": "CEDS + CTDL + CTDL-ASN + CTDL-QData, hubs CEDS and CTDL, the P6 declared bridges (CTDL→CEDS, CTDL-ASN→CTDL) and the CTDL family structure.",
  "standards": [
    { "token": "ceds", "version": "current" },
    { "token": "ctdl", "version": "current" },
    { "token": "ctdlasn", "version": "current" },
    { "token": "ctdlqdata", "version": "current" }
  ],
  "hubs": [
    { "standard": "ceds" },
    { "standard": "ctdl" }
  ],
  "bridges": [
    { "source": "ctdl", "hubs": ["ceds"], "dependencies": ["ctdl", "ceds"] },
    { "source": "ctdlasn", "hubs": ["ctdl"], "dependencies": ["ctdlasn", "ctdl"] },
    { "source": "ctdl", "familyStandards": ["ctdl", "ctdlasn", "ctdlqdata"], "bridge": "ctdlFamilyStructure", "dependencies": ["ctdl", "ctdlasn", "ctdlqdata"] }
  ]
}
