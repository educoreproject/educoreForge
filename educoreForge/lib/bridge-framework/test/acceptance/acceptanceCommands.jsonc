			"rejudgeRealLimit": null,
			"materialiseReal": { "sessionName": "SABLE_RIVER", "date": "2026-08-16", "note": "RULINGS-supervisor-bridgeFramework.md, block 'Ed-Fi crosswalk PROVENANCE — settled' (3); 216 judged subjects; GO by IMCS 2026-08-16 19:21 CDT" }
