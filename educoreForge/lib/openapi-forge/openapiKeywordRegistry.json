			"format": { "carriage": "nodeProperty", "propertyName": "itemsDataFormat", "valueKind": "string" },
			"pattern": { "carriage": "nodeProperty", "propertyName": "itemsValuePattern", "valueKind": "string" },
			"$ref": { "carriage": "reference" },
			"enum": { "carriage": "enum" },
			"oneOf": { "carriage": "composition" },
			"anyOf": { "carriage": "composition" },
			"allOf": { "carriage": "composition" }
		},
		"branch": {
