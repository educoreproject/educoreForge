			"additionalProperties": { "carriage": "nodeProperty", "propertyName": "additionalPropertiesAllowed", "valueKind": "boolean" },
			"required": { "carriage": "requiredList" },
			"properties": { "carriage": "propertyMap" }
		},
		"property": {
			"type": { "carriage": "nodeProperty", "propertyName": "dataType", "valueKind": "string" },
			"description": { "carriage": "nodeProperty", "propertyName": "description", "valueKind": "string" },
			"format": { "carriage": "nodeProperty", "propertyName": "dataFormat", "valueKind": "string" },
			"pattern": { "carriage": "nodeProperty", "propertyName": "valuePattern", "valueKind": "string" },
			"minItems": { "carriage": "nodeProperty", "propertyName": "minItems", "valueKind": "integer" },
			"items": { "carriage": "items" },
			"$ref": { "carriage": "reference" },
			"enum": { "carriage": "enum" },
			"oneOf": { "carriage": "composition" },
			"anyOf": { "carriage": "composition" },
			"allOf": { "carriage": "composition" }
		},
		"items": {
