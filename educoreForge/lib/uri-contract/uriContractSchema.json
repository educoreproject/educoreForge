{
	"about": "The nine tables of uriContract.sqlite (ML3.1 Part B; PROPOSAL-dataStoreLayout-102626 section 3 and Appendix B, with the additive columns AMBER_JOURNEY accepted 2026-10-26, and the ninth table frozenVectors ruled the same day: a vector a published schema block references by embeddingRef is part of what RECREATES the graph, not a calculation input). DATA: uriContract.js builds every CREATE TABLE, every write-once trigger and every INSERT from these rows, and refuses by name a row field no table lists. rowRole 'identity' = written once at publish; 'history' = append-only. NO TABLE IS EVER UPDATED OR DELETED FROM: each carries BEFORE UPDATE and BEFORE DELETE triggers that abort, so even raw SQL cannot edit the forever-promise. registrationStatus CHECKs are built from lib/layer-registry/layerRegistrySchema.json registrationStatusList, never restated here.",
	"writeOnceTriggerMessage": "uriContract is write-once: rows are never updated or deleted (a status change is a new history row)",
	"tableList": [
		{
			"tableName": "agents",
			"rowRole": "identity",
			"about": "authors of record: people (pseudonymous, by userRefId: a role and aliases, never a name or an e-mail), judges (with their configuration), organisations; the PROFILE only. An agent URI also answers a computed RECORD (what the agent authored, its status, counts, scores, dates), which is NEVER stored: it is computed from layerVersions and layerStatusChanges (TQ ruling Q3, 2026-10-26)",
			"columnList": [
				{ "columnName": "agentIri", "sqlType": "TEXT", "constraintText": "PRIMARY KEY" },
				{ "columnName": "agentKind", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (agentKind IN ('person', 'judge', 'organisation'))" },
				{ "columnName": "displayName", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "description", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "homepageIri", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "aliasIriListJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "judgeConfigurationJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "note", "sqlType": "TEXT", "constraintText": "" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "schemaBlocks",
			"rowRole": "identity",
			"about": "every schema block a published manifest lists; verify on read: sha256(text) = refId",
			"columnList": [
				{ "columnName": "refId", "sqlType": "TEXT", "constraintText": "PRIMARY KEY CHECK (length(refId) = 64)" },
				{ "columnName": "kind", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "subject", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "version", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "requiresJson", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "text", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "producedBy", "sqlType": "TEXT", "constraintText": "" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "frozenVectors",
			"rowRole": "identity",
			"about": "every vector a published schema block references by embeddingRef (NOT the embedding cache): the support store's vectors rows, copied at publish; verify on read: dtype and length, the vectorId recipe over (modelVersion, dims, inputText) (grammar 2, or grammar 1 for a row minted before campaign P3), and sha256(vector) = vectorHash",
			"columnList": [
				{ "columnName": "vectorId", "sqlType": "TEXT", "constraintText": "PRIMARY KEY CHECK (length(vectorId) = 64)" },
				{ "columnName": "modelVersion", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "dims", "sqlType": "INTEGER", "constraintText": "NOT NULL CHECK (dims > 0)" },
				{ "columnName": "dtype", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "inputText", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "vector", "sqlType": "BLOB", "constraintText": "NOT NULL" },
				{ "columnName": "vectorHash", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (length(vectorHash) = 64)" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "publishedManifests",
			"rowRole": "identity",
			"about": "one row per published manifest; manifestRefId = content-address manifestKeyForMembership of its members; the label is never 'sha256' and never reassigned; defaultLayerByHubJson is NULL unless one standard-hub pair carries edges from two producers (AMBER_JOURNEY ruling (b) 2026-10-26: a question URI answers from the manifest's own relationship schema blocks)",
			"columnList": [
				{ "columnName": "manifestRefId", "sqlType": "TEXT", "constraintText": "PRIMARY KEY CHECK (length(manifestRefId) = 64)" },
				{ "columnName": "publicLabel", "sqlType": "TEXT", "constraintText": "NOT NULL UNIQUE CHECK (publicLabel <> 'sha256' AND publicLabel <> '')" },
				{ "columnName": "uri", "sqlType": "TEXT", "constraintText": "NOT NULL UNIQUE" },
				{ "columnName": "uriByContent", "sqlType": "TEXT", "constraintText": "NOT NULL UNIQUE" },
				{ "columnName": "defaultLayerByHubJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "basedOnManifestRefId", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "recordedNodeCount", "sqlType": "INTEGER", "constraintText": "NOT NULL CHECK (recordedNodeCount >= 0)" },
				{ "columnName": "recordedEdgeCount", "sqlType": "INTEGER", "constraintText": "NOT NULL CHECK (recordedEdgeCount >= 0)" },
				{ "columnName": "publishedAt", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "publishedByAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "publishedManifestMembers",
			"rowRole": "identity",
			"about": "the assembly of each manifest, written once with it, in replay order",
			"columnList": [
				{ "columnName": "manifestRefId", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES publishedManifests(manifestRefId)" },
				{ "columnName": "position", "sqlType": "INTEGER", "constraintText": "NOT NULL" },
				{ "columnName": "schemaBlockRefId", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES schemaBlocks(refId)" }
			],
			"tableConstraintList": ["PRIMARY KEY (manifestRefId, schemaBlockRefId)", "UNIQUE (manifestRefId, position)"]
		},
		{
			"tableName": "manifestStatusChanges",
			"rowRole": "history",
			"about": "append-only status history of each manifest; the effective status is the latest row",
			"columnList": [
				{ "columnName": "rowId", "sqlType": "INTEGER", "constraintText": "PRIMARY KEY AUTOINCREMENT" },
				{ "columnName": "manifestRefId", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES publishedManifests(manifestRefId)" },
				{ "columnName": "registrationStatus", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (registrationStatus IN (<!registrationStatusList!>))" },
				{ "columnName": "registrationAuthority", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "changedAt", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "changedByAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "note", "sqlType": "TEXT", "constraintText": "" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "decisionSchemaBlocks",
			"rowRole": "identity",
			"about": "every decision schema block a published layer version is made of; verify on read: sha256(frozenText) = decisionSchemaBlockHash",
			"columnList": [
				{ "columnName": "decisionSchemaBlockHash", "sqlType": "TEXT", "constraintText": "PRIMARY KEY CHECK (length(decisionSchemaBlockHash) = 64)" },
				{ "columnName": "pairKey", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "producerKind", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "frozenText", "sqlType": "TEXT", "constraintText": "NOT NULL" }
			],
			"tableConstraintList": []
		},
		{
			"tableName": "layerVersions",
			"rowRole": "identity",
			"about": "one row per layer version, no status; the layer's own fields (layerKind, displayName, layerAuthorAgentIri, standardListJson, hubListJson) are recorded as of this version's publication",
			"columnList": [
				{ "columnName": "layerKey", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "versionTag", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "contentId", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (length(contentId) = 64)" },
				{ "columnName": "layerKind", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "displayName", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "layerAuthorAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "standardListJson", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "hubListJson", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "authorAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "registrationAuthorityIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "registrarIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "submitterAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "publishedAt", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "contentIdBasis", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "memberListJson", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "wholeSetBlockJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "sssomPath", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "importRecordJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "copiedFromLayerVersion", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "note", "sqlType": "TEXT", "constraintText": "" }
			],
			"tableConstraintList": ["PRIMARY KEY (layerKey, versionTag)", "UNIQUE (layerKey, contentId)"]
		},
		{
			"tableName": "layerStatusChanges",
			"rowRole": "history",
			"about": "append-only status history of each layer version: its first row (statusChangeKind atPublication) is the status it was published with, carrying the scores recorded then; later rows are appended changes",
			"columnList": [
				{ "columnName": "rowId", "sqlType": "INTEGER", "constraintText": "PRIMARY KEY AUTOINCREMENT" },
				{ "columnName": "layerKey", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "versionTag", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "statusChangeKind", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (statusChangeKind IN ('atPublication', 'appended'))" },
				{ "columnName": "registrationStatus", "sqlType": "TEXT", "constraintText": "NOT NULL CHECK (registrationStatus IN (<!registrationStatusList!>))" },
				{ "columnName": "supersededByVersionTag", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "scoreListJson", "sqlType": "TEXT", "constraintText": "" },
				{ "columnName": "changedAt", "sqlType": "TEXT", "constraintText": "NOT NULL" },
				{ "columnName": "changedByAgentIri", "sqlType": "TEXT", "constraintText": "NOT NULL REFERENCES agents(agentIri)" },
				{ "columnName": "note", "sqlType": "TEXT", "constraintText": "" }
			],
			"tableConstraintList": ["FOREIGN KEY (layerKey, versionTag) REFERENCES layerVersions(layerKey, versionTag)"]
		}
	],
	"indexList": [
		"CREATE UNIQUE INDEX IF NOT EXISTS layerStatusChangesOnePublicationRow ON layerStatusChanges(layerKey, versionTag) WHERE statusChangeKind = 'atPublication'"
	]
}
